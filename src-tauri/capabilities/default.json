{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permissions for the Cowriter main window",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "fs:allow-read-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://accounts.google.com/**"
        }
      ]
    }
  ]
}
